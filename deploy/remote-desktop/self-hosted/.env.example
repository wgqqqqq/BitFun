# Build this checkout with docker compose build. Use a reviewed image digest
# for a production deployment instead of moving an existing instance's tag.
REMOTE_DESKTOP_IMAGE=openbitfun-remote-desktop:local
REMOTE_DESKTOP_PORT=9701
# Set these to a non-root host user owning ./private and ./data.
REMOTE_DESKTOP_UID=10001
REMOTE_DESKTOP_GID=10001
# Operator-controlled coturn endpoints. No public third-party default is used.
REMOTE_DESKTOP_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
