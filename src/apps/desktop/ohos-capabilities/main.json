{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ohos-main",
  "description": "HarmonyOS PC main workbench; native window controls use the desktop host bridge.",
  "windows": [
    "main"
  ],
  "permissions": [
    "log:default",
    "core:event:default",
    "core:path:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "opener:allow-open-url",
    "dialog:allow-open"
  ]
}
